diff -urN a/build/main.rs b/build/main.rs
--- a/build/main.rs
+++ b/build/main.rs
@@ -131,1 +131,43 @@
 fn main() {
+    println!("cargo:rustc-cfg=openssl");
+
+    // 1. Declare S-CORE's compiled OpenSSL version and the highest supported crate version
+    const S_CORE_OPENSSL_VERSION: &str = "3.6.1";
+    const MAX_SUPPORTED_VERSION: &str = "3.5.0";
+
+    // 2. Perform safety validation:
+    // If S-CORE's C++ OpenSSL is upgraded to an incompatible major version (like 4.0.0 or 5.0.0)
+    // without upgrading the Rust crate, we intentionally throw a clear, custom compile error!
+    let s_core_major: u64 = S_CORE_OPENSSL_VERSION.split('.').next().unwrap().parse().unwrap();
+    let max_major: u64 = MAX_SUPPORTED_VERSION.split('.').next().unwrap().parse().unwrap();
+    if s_core_major > max_major {
+        panic!(
+            "Incompatibility Error: S-CORE's compiled OpenSSL version ({}) has a different major release than this crate's highest supported bindings ({})! Please upgrade the openssl-sys crate version in Cargo.toml.",
+            S_CORE_OPENSSL_VERSION,
+            MAX_SUPPORTED_VERSION
+        );
+    }
+
+    // 3. Emit the correct, matching version flags up to the highest supported fallback
+    println!("cargo:rustc-cfg=ossl101");
+    println!("cargo:rustc-cfg=ossl102");
+    println!("cargo:rustc-cfg=ossl102f");
+    println!("cargo:rustc-cfg=ossl102h");
+    println!("cargo:rustc-cfg=ossl110");
+    println!("cargo:rustc-cfg=ossl110f");
+    println!("cargo:rustc-cfg=ossl110g");
+    println!("cargo:rustc-cfg=ossl110h");
+    println!("cargo:rustc-cfg=ossl111");
+    println!("cargo:rustc-cfg=ossl111b");
+    println!("cargo:rustc-cfg=ossl111c");
+    println!("cargo:rustc-cfg=ossl111d");
+    println!("cargo:rustc-cfg=ossl300");
+    println!("cargo:rustc-cfg=ossl310");
+    println!("cargo:rustc-cfg=ossl320");
+    println!("cargo:rustc-cfg=ossl330");
+    println!("cargo:rustc-cfg=ossl340");
+    println!("cargo:rustc-cfg=ossl350");
+
+    println!("cargo:version_number=30500000"); // 3.5.0 (highest version openssl-sys 0.9.116 supports for OpenSSL 3.6.1 fallback)
+    println!("cargo:conf=OPENSSL_NO_ACVP_TESTS,OPENSSL_NO_AFALGENG,OPENSSL_NO_ALLOCFAIL_TESTS,OPENSSL_NO_APPS,OPENSSL_NO_ARIA,OPENSSL_NO_ASAN,OPENSSL_NO_ASM,OPENSSL_NO_ASYNC,OPENSSL_NO_BF,OPENSSL_NO_BROTLI,OPENSSL_NO_BROTLI_DYNAMIC,OPENSSL_NO_CAMELLIA,OPENSSL_NO_CAST,OPENSSL_NO_CMS,OPENSSL_NO_COMP,OPENSSL_NO_COMP_ALG,OPENSSL_NO_CRYPTO_MDEBUG,OPENSSL_NO_CRYPTO_MDEBUG_BACKTRACE,OPENSSL_NO_CT,OPENSSL_NO_DEFAULT_THREAD_POOL,OPENSSL_NO_DEMOS,OPENSSL_NO_DEVCRYPTOENG,OPENSSL_NO_DGRAM,OPENSSL_NO_DOCS,OPENSSL_NO_DTLS,OPENSSL_NO_DTLS1,OPENSSL_NO_DTLS1_2,OPENSSL_NO_EC_NISTP_64_GCC_128,OPENSSL_NO_EGD,OPENSSL_NO_EXTERNAL_TESTS,OPENSSL_NO_FIPS_JITTER,OPENSSL_NO_FIPS_POST,OPENSSL_NO_FIPS_SECURITYCHECKS,OPENSSL_NO_FUZZ_AFL,OPENSSL_NO_FUZZ_LIBFUZZER,OPENSSL_NO_GOST,OPENSSL_NO_H3DEMO,OPENSSL_NO_HQINTEROP,OPENSSL_NO_IDEA,OPENSSL_NO_JITTER,OPENSSL_NO_KTLS,OPENSSL_NO_LMS,OPENSSL_NO_MD2,OPENSSL_NO_MD4,OPENSSL_NO_MDC2,OPENSSL_NO_MSAN,OPENSSL_NO_NEXTPROTONEG,OPENSSL_NO_OCSP,OPENSSL_NO_PADLOCKENG,OPENSSL_NO_PIE,OPENSSL_NO_PSK,OPENSSL_NO_QLOG,OPENSSL_NO_QUIC,OPENSSL_NO_RC2,OPENSSL_NO_RC4,OPENSSL_NO_RC5,OPENSSL_NO_SCTP,OPENSSL_NO_SEED,OPENSSL_NO_SM2,OPENSSL_NO_SM3,OPENSSL_NO_SM4,OPENSSL_NO_SOCK,OPENSSL_NO_SRP,OPENSSL_NO_SRTP,OPENSSL_NO_SSL3,OPENSSL_NO_SSL3_METHOD,OPENSSL_NO_SSLKEYLOG,OPENSSL_NO_STATIC_ENGINE,OPENSSL_NO_TESTS,OPENSSL_NO_TFO,OPENSSL_NO_THREAD_POOL,OPENSSL_NO_TLS1,OPENSSL_NO_TLS1_1,OPENSSL_NO_TRACE,OPENSSL_NO_UBSAN,OPENSSL_NO_UI_CONSOLE,OPENSSL_NO_UNIT_TEST,OPENSSL_NO_UNSTABLE_QLOG,OPENSSL_NO_UPLINK,OPENSSL_NO_WEAK_SSL_CIPHERS,OPENSSL_NO_WHIRLPOOL,OPENSSL_NO_WINSTORE,OPENSSL_NO_ZLIB,OPENSSL_NO_ZLIB_DYNAMIC,OPENSSL_NO_ZSTD,OPENSSL_NO_ZSTD_DYNAMIC"); // OPENSSL_NO_* set of the S-CORE build: mirrors the generated include/openssl/configuration.h; regenerate when Configure flags in //third_party/openssl change
+    return;
