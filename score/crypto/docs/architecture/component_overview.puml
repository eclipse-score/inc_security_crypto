@startuml Component Overview
title __Architecture overview__

set namespaceSeparator ::
top to bottom direction
skinparam nodesep 2
skinparam ranksep 72

' ====================================================================
' CLIENT SIDE
' ====================================================================
package "Client Library (score::crypto)" <<Rectangle>> {
    interface "api::ICryptoStack" as CryptoStack {
        +CreateCryptoContext() : ICryptoContext
    }
    interface "api::ICryptoContext" as CryptoContext {
        +ResolveResource(...) : CryptoResourceId
        +CreateHashContext(...) : IHashContext
        +CreateCipherContext(...) : ICipherContext
        +...()
    }
    CryptoStack ..> CryptoContext : creates
}

' ====================================================================
' IPC TRANSPORT
' ====================================================================
package "IPC (score::crypto::ipc)" <<Rectangle>> {
    class "ipc::GrpcControlServer" as GrpcControlServer {
        +Start(socket_path)
        +Stop()
        +WaitForTermination()
    }
}

' ====================================================================
' DAEMON
' ====================================================================
package "Daemon (score::crypto::daemon)" <<Rectangle>> {

    ' --- Control Plane ---
    package control_plane <<Rectangle>> #F5F5F5 {

        interface "control_plane::IControlServer" as ControlServer {
            +Start(socket_path)
            +Stop()
            +WaitForTermination()
        }

        interface "control_plane::IHandlerChainFactory" as HandlerChainFactory {
            +CreateRequestHandler() : IRequestHandler
        }

        interface "control_plane::IRequestHandler" as RequestHandler {
            +processRequest(request) : ControlResponse
        }

        class "control_plane::BasicHandlerChainFactory" as BasicHandlerChainFactory {
            +CreateRequestHandler() : IRequestHandler
        }

        class "control_plane::ConnectionHandler" as ConnectionHandler {
            +processRequest(request) : ControlResponse
        }

        GrpcControlServer .up.|> ControlServer
        GrpcControlServer *-- HandlerChainFactory : owns
        BasicHandlerChainFactory .up.|> HandlerChainFactory
        ConnectionHandler .up.|> RequestHandler
        BasicHandlerChainFactory ..> ConnectionHandler : creates
    }

    ' --- Mediator ---
    package mediator <<Rectangle>> #F0F0FF {
        interface "mediator::IMediator" as Mediator {
            +processRequest(request) : ControlResponse
        }
        class "mediator::MediatorImpl" as MediatorImpl {
            +processRequest(request) : ControlResponse
        }
        Mediator .up.|> RequestHandler
        MediatorImpl .up.|> Mediator
        ConnectionHandler *-- Mediator : delegates to
    }

    ' --- Data Manager ---
    package data_manager <<Rectangle>> #FFF8DC {
        interface "data_manager::IDataManager" as DataManager {
            +GetNode(...) : DataNode
            +CreateNode(...) : DataNodeId
        }
        MediatorImpl o-- DataManager
    }

    ' --- Key Management ---
    package key_management <<Rectangle>> #F0FFF0 {
        class "key_management::KeyManagementModule" as KeyManagementModule {
            +{static} Create(...) : Sptr
            +GetService() : KeyManagementService::Sptr
        }
        class "key_management::KeyManagementService" as KeyManagementService {
            +ResolveKeySlot(...) : Expected<DataNodeId>
            +RegisterKeyMaterial(...)
            +BindKeyToContext(...)
        }
        KeyManagementModule *-- KeyManagementService
        MediatorImpl o-- KeyManagementService
    }

    ' --- Provider ---
    package provider <<Rectangle>> #E8F5E9 {

        interface "provider::IProvider" as Provider {
            +Initialize(context : ProviderInitContext) : bool
            +Shutdown() : void
            +IsInitialized() : bool
        }

        interface "provider::IProviderFactory" as ProviderFactory {
            +CreateAndRegister(manager : ProviderManager&) : ProviderFactoryResult
        }

        class "provider::ProviderManagerFactory" as ProviderManagerFactory {
            +{static} Create(config : Config&) : Expected<ProviderManager::Sptr, DaemonErrorCode>
        }
        note right of ProviderManagerFactory : Internally instantiates and wires\nconcrete provider factories based\non build configuration.

        class "provider::ProviderManager" as ProviderManager {
            +Initialize() : bool
            +RegisterProvider(name, provider, type) : bool
            +IsProviderRegistered(name) : bool
            +GetProvider(id) : IProvider::Sptr
        }

        package backend <<Rectangle>> #E0F2F1 {
            package backend_score_provider {
                class "ActiveBackends" as BackendActiveBackends {
                    +GetActiveBackends() : vector<IBackendProviderAdapter>
                }
            }
            package backend_pkcs11 {
                class "SelectedBackend" as BackendSelectedBackend {
                    <<Bazel label_flag>>
                }
            }
        }

        package provider_score_provider {
            class "ScoreProviderConfig" as ScoreProviderConfigNode {
                +GetConfig()
            }

            class "ScoreProviderFactory" as ScoreProviderFactoryNode {
                +ScoreProviderFactory(config)
                +CreateAndRegister(manager) : bool
            }
        }

        package provider_pkcs11 {
            class "Pkcs11Config" as Pkcs11ConfigNode {
                +GetConfig()
            }

            class "Pkcs11ProviderFactory" as Pkcs11ProviderFactoryNode {
                +Pkcs11ProviderFactory(config)
                +CreateAndRegister(manager) : bool
            }
        }

        ProviderManager *-- Provider : 1..n
        ScoreProviderFactoryNode .up.|> ProviderFactory
        Pkcs11ProviderFactoryNode .up.|> ProviderFactory
        ScoreProviderConfigNode ..> ScoreProviderFactoryNode : supplies config snapshot
        Pkcs11ConfigNode ..> Pkcs11ProviderFactoryNode : supplies config snapshot
        ScoreProviderFactoryNode ..> BackendActiveBackends : resolves providerImpl
        BackendSelectedBackend ..> Pkcs11ProviderFactoryNode : linked backend
        ProviderManagerFactory ..> ProviderManager : creates, registers, initializes
        ProviderManagerFactory ..> ScoreProviderFactoryNode : conditionally creates
        ProviderManagerFactory ..> Pkcs11ProviderFactoryNode : conditionally creates
        ProviderManagerFactory ..> ScoreProviderConfigNode : parses/configures
        ProviderManagerFactory ..> Pkcs11ConfigNode : parses/configures
    }

    MediatorImpl o-- ProviderManager
    KeyManagementModule o-- ProviderManager

    ' Keep the daemon layers readable on portrait-oriented output.
    ControlServer -[hidden]down- Mediator
    Mediator -[hidden]down- DataManager
    DataManager -[hidden]down- KeyManagementModule
    KeyManagementModule -[hidden]down- ProviderManager
}

' ====================================================================
' CROSS-BOUNDARY CONNECTIONS
' ====================================================================
CryptoStack ..> GrpcControlServer : IPC (Unix socket / gRPC)
CryptoStack -[hidden]down- GrpcControlServer
GrpcControlServer -[hidden]down- ControlServer

legend right
  **Not shown:** Logging, session node cleanup,
  DataNode tree, key registry, slot registry.
endlegend

@enduml
