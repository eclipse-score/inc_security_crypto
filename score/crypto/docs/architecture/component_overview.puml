@startuml Component Overview
title __Architecture overview__

set namespaceSeparator ::
top to bottom direction
skinparam nodesep 2
skinparam ranksep 72

' ====================================================================
' CLIENT SIDE
' ====================================================================
package "Client Library (score::crypto)" <<Rectangle>> {
    interface api::ICryptoStack {
        +CreateCryptoContext() : ICryptoContext
    }
    interface api::ICryptoContext {
        +ResolveResource(...) : CryptoResourceId
        +CreateHashContext(...) : IHashContext
        +CreateCipherContext(...) : ICipherContext
        +...()
    }
    api::ICryptoStack ..> api::ICryptoContext : creates
}

' ====================================================================
' IPC TRANSPORT
' ====================================================================
package "IPC (score::crypto::ipc)" <<Rectangle>> {
    class ipc::GrpcControlServer {
        +Start(socket_path)
        +Stop()
        +WaitForTermination()
    }
}

' ====================================================================
' DAEMON
' ====================================================================
package "Daemon (score::crypto::daemon)" <<Rectangle>> {

    ' --- Control Plane ---
    package control_plane <<Rectangle>> #F5F5F5 {

        interface control_plane::IControlServer {
            +Start(socket_path)
            +Stop()
            +WaitForTermination()
        }

        interface control_plane::IHandlerChainFactory {
            +CreateRequestHandler() : IRequestHandler
        }

        interface control_plane::IRequestHandler {
            +processRequest(request) : ControlResponse
        }

        class control_plane::BasicHandlerChainFactory {
            +CreateRequestHandler() : IRequestHandler
        }

        class control_plane::ConnectionHandler {
            +processRequest(request) : ControlResponse
        }

        ipc::GrpcControlServer .up.|> control_plane::IControlServer
        ipc::GrpcControlServer *-- control_plane::IHandlerChainFactory : owns
        control_plane::BasicHandlerChainFactory .up.|> control_plane::IHandlerChainFactory
        control_plane::ConnectionHandler .up.|> control_plane::IRequestHandler
        control_plane::BasicHandlerChainFactory ..> control_plane::ConnectionHandler : creates
    }

    ' --- Mediator ---
    package mediator <<Rectangle>> #F0F0FF {
        interface mediator::IMediator {
            +processRequest(request) : ControlResponse
        }
        class mediator::MediatorImpl {
            +processRequest(request) : ControlResponse
        }
        mediator::IMediator .up.|> control_plane::IRequestHandler
        mediator::MediatorImpl .up.|> mediator::IMediator
        control_plane::ConnectionHandler *-- mediator::IMediator : delegates to
    }

    ' --- Data Manager ---
    package data_manager <<Rectangle>> #FFF8DC {
        interface data_manager::IDataManager {
            +GetNode(...) : DataNode
            +CreateNode(...) : DataNodeId
        }
        mediator::MediatorImpl o-- data_manager::IDataManager
    }

    ' --- Key Management ---
    package key_management <<Rectangle>> #F0FFF0 {
        class key_management::KeyManagementModule {
            +{static} Create(...) : Sptr
            +GetService() : KeyManagementService::Sptr
        }
        class key_management::KeyManagementService {
            +ResolveKeySlot(...) : Expected<DataNodeId>
            +RegisterKeyMaterial(...)
            +BindKeyToContext(...)
        }
        key_management::KeyManagementModule *-- key_management::KeyManagementService
        mediator::MediatorImpl o-- key_management::KeyManagementService
    }

    ' --- Provider ---
    package provider <<Rectangle>> #E8F5E9 {

        interface provider::IProvider {
            +Initialize(context : ProviderInitContext) : bool
            +Shutdown() : void
            +IsInitialized() : bool
        }

        interface provider::IProviderFactory {
            +CreateAndRegister(manager : ProviderManager&) : ProviderFactoryResult
        }

        class provider::ProviderManagerFactory {
            +{static} Create(config : Config&) : Expected<ProviderManager::Sptr, DaemonErrorCode>
        }
        note right of provider::ProviderManagerFactory
            Internally instantiates and wires
            concrete provider factories based
            on build configuration.
        end note

        class provider::ProviderManager {
            +Initialize() : bool
            +RegisterProvider(name, provider, type) : bool
            +IsProviderRegistered(name) : bool
            +GetProvider(id) : IProvider::Sptr
        }

        package backend <<Rectangle>> #E0F2F1 {
            package backend_score_provider {
                class "ActiveBackends" as BackendActiveBackends {
                    +GetActiveBackends() : vector<IBackendProviderAdapter>
                }
            }
            package backend_pkcs11 {
                class "SelectedBackend" as BackendSelectedBackend {
                    <<Bazel label_flag>>
                }
            }
        }

        package provider_score_provider {
            class "ScoreProviderConfig" as ScoreProviderConfigNode {
                +GetConfig()
            }

            class "ScoreProviderFactory" as ScoreProviderFactoryNode {
                +ScoreProviderFactory(config)
                +CreateAndRegister(manager) : bool
            }
        }

        package provider_pkcs11 {
            class "Pkcs11Config" as Pkcs11ConfigNode {
                +GetConfig()
            }

            class "Pkcs11ProviderFactory" as Pkcs11ProviderFactoryNode {
                +Pkcs11ProviderFactory(config)
                +CreateAndRegister(manager) : bool
            }
        }

        provider::ProviderManager *-- provider::IProvider : 1..n
        ScoreProviderFactoryNode .up.|> provider::IProviderFactory
        Pkcs11ProviderFactoryNode .up.|> provider::IProviderFactory
        ScoreProviderConfigNode ..> ScoreProviderFactoryNode : supplies config snapshot
        Pkcs11ConfigNode ..> Pkcs11ProviderFactoryNode : supplies config snapshot
        ScoreProviderFactoryNode ..> BackendActiveBackends : resolves providerImpl
        BackendSelectedBackend ..> Pkcs11ProviderFactoryNode : linked backend
        provider::ProviderManagerFactory ..> provider::ProviderManager : creates, registers, initializes
        provider::ProviderManagerFactory ..> ScoreProviderFactoryNode : conditionally creates
        provider::ProviderManagerFactory ..> Pkcs11ProviderFactoryNode : conditionally creates
        provider::ProviderManagerFactory ..> ScoreProviderConfigNode : parses/configures
        provider::ProviderManagerFactory ..> Pkcs11ConfigNode : parses/configures
    }

    mediator::MediatorImpl o-- provider::ProviderManager
    key_management::KeyManagementModule o-- provider::ProviderManager

    ' Keep the daemon layers readable on portrait-oriented output.
    control_plane::IControlServer -[hidden]down- mediator::IMediator
    mediator::IMediator -[hidden]down- data_manager::IDataManager
    data_manager::IDataManager -[hidden]down- key_management::KeyManagementModule
    key_management::KeyManagementModule -[hidden]down- provider::ProviderManager
}

' ====================================================================
' CROSS-BOUNDARY CONNECTIONS
' ====================================================================
api::ICryptoStack ..> ipc::GrpcControlServer : IPC (Unix socket / gRPC)
api::ICryptoStack -[hidden]down- ipc::GrpcControlServer
ipc::GrpcControlServer -[hidden]down- control_plane::IControlServer

legend right
  **Not shown:** Logging, session node cleanup,
  DataNode tree, key registry, slot registry.
endlegend

@enduml
