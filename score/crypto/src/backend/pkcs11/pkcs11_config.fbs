include "buffer_version.fbs";

file_identifier "P11C";

namespace score.crypto.backend.pkcs11.config;

enum ProviderType : byte {
  HARDWARE = 0,
  SOFTWARE = 1,
  SPECIALIZED = 2
}

enum CleanupStrategy : byte {
  SOFT = 0,
  HARD = 1
}

/// Runtime configuration for one token exposed as one crypto provider.
table TokenEntry {
  token_label: string (required, id: 0);
  token_model: string (id: 1);
  user_pin: string (id: 2);
  provider_name: string (required, id: 3);
  provider_type: ProviderType = HARDWARE (id: 4);
  cleanup_strategy: CleanupStrategy = HARD (id: 5);
}

/// PKCS#11-owned configuration root.
table Pkcs11BackendConfig {
  /// Standard SCORE buffer version envelope. This must remain at field ID 0.
  version_info: score.flatbuffers.BufferVersion (id: 0);
  tokens: [TokenEntry] (required, id: 1);
}

root_type Pkcs11BackendConfig;
