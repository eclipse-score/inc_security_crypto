@startuml
participant "Flat-config parser" as Config
participant "ConfigDrivenSlotCatalog" as SlotCatalog
participant "CertSlotRegistry" as Slots
participant "ConfigDrivenTrustStoreCatalog" as TrustCatalog
participant "TrustStoreManager" as Stores
participant "CertManagementService" as Service
participant "FileBackedSlotHandler" as Handler
participant "OpenSslCertParser" as Parser
participant "TrustStoreHandler" as StoreHandler
participant "DataManager" as Data

Config -> SlotCatalog : CertificateConfig
SlotCatalog -> Slots : RegisterSlot(config)
Config -> TrustCatalog : CertificateConfig
TrustCatalog -> Stores : Load(store configs, registry, factory)
TrustCatalog -> Stores : RegisterAppResource()

Service -> Slots : ResolveAppResource(resource, client)
Slots --> Service : CertSlotHandle
Service -> Data : addNode(CertSlotDataNode)
Data --> Service : slot_node_id

Service -> Handler : LoadCertificate(slot config)
Handler -> Parser : ParseCertificate(bytes, format)
Parser --> Handler : CertObject
Handler --> Service : CertObject
Service -> Data : addChildNode(CertDataNode)

Service -> Stores : ResolveAppResource(trust resource, client)
Stores --> Service : TrustStoreHandle
Service -> Stores : GetStore(handle)
Stores --> Service : TrustStoreHandler
Service -> StoreHandler : GetAnchors()
StoreHandler -> Stores : lazy AnchorLoader
Stores -> Handler : LoadCertificate(slot config)
Handler -> Parser : ParseCertificate(bytes, format)
Parser --> Handler : CertObject
Handler --> Stores : CertObject
Stores -> StoreHandler : NotifySlotUpdate(slot, cert)
StoreHandler --> Service : anchors

Service -> Handler : StoreCertificate(updated cert)
Handler -> "Shared Deployment Storage" : atomic cert + metadata write
Service -> Stores : NotifySlotChanged(store, slot)
Stores -> StoreHandler : InvalidateSlot(slot)
Service -> StoreHandler : GetAnchors()
StoreHandler -> Stores : reload changed slot
Stores -> Handler : LoadCertificate()
Handler -> Parser : ParseCertificate()
Parser --> Handler : updated CertObject
Handler --> Stores : updated CertObject
Stores -> StoreHandler : NotifySlotUpdate()
StoreHandler --> Service : updated anchors
@enduml
