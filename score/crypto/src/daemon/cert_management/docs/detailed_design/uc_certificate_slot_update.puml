@startuml uc_certificate_slot_update
title Use Case: Write a Certificate Slot and Refresh Trust Stores
autonumber
hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ParticipantPadding 18
skinparam sequenceMessageAlign center

actor Application as App
participant "Public context + IPC" as Context
participant "CERT:MANAGEMENT\nhandler + executor" as Executor
participant "CertManagementService" as Service
participant "CertSlotManager" as SlotManager
participant "CertSlotRegistry" as Registry
participant "ICertSlotHandler +\nstorage" as Backend
participant "TrustStoreManager" as TrustManager
participant "TrustStoreHandler" as StoreHandler

App -> Context : SaveCertificate(cert, target slot)
Context -> Executor : save request
Executor -> Service : UpdateSlot(slot, client, cert)
Service -> SlotManager : StoreCertificate(slot, client, cert)
SlotManager -> Registry : CheckWriteAccess(slot, client)

alt write denied
  SlotManager --> Service : access error
  Service --> Executor : error
  Executor --> Context : error response
else write allowed
  SlotManager -> Backend : StoreCertificate(cert)
  Backend -> Backend : write certificate and descriptor,\ndiscard the CRL of the previous certificate
  Backend --> SlotManager : success or error
  SlotManager -> SlotManager : invalidate certificate and CRL cache entries,\nadvance slot generation
  SlotManager --> Service : result

  Service -> TrustManager : NotifySlotChanged(slot)
  loop each referencing trust store
    TrustManager -> StoreHandler : OnSlotChanged(slot)
    StoreHandler -> SlotManager : InvalidateSlotCaches(slot)
    alt conditional-external member
      StoreHandler -> StoreHandler : disable member and persist state if fingerprint differs
    else other member kind
      opt cache warm
        StoreHandler -> SlotManager : reload member certificate and CRL
      end
    end
  end
  Service --> Executor : result

  group Planned: SaveCertificateWithCrl, CRL propagation from the source
    Executor -> Service : UpdateSlot(slot, client, CRL)
    note right of Service
      CRL taken from the source (session CRL or source slot). Same
      notification path as a CRL import: see "Import a CRL".
    end note
  end
  Executor --> Context : result
end
Context --> App : result

note over Service, StoreHandler
  The notification is part of the service operation, not a separate step
  for the caller. A denied write does not notify. A failed backend write still
  notifies, because the stored content may have changed. A slot written outside
  the service is not detected.
end note
@enduml
