@startuml uc_certificate_slot_load
title Use Case: Load a Certificate from a Slot
autonumber
hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ParticipantPadding 18
skinparam sequenceMessageAlign center

actor Application as App
participant "Public context + IPC" as Context
participant "CERT:MANAGEMENT\nhandler + executor" as Executor
participant "CertManagementService" as Service
participant "DataManager" as DataManager
participant "CertSlotManager" as SlotManager
participant "ICertSlotHandler +\ncanonical ICertParser" as Backend
participant "CertRegistry" as Registry

App -> Context : LoadCertificate(slot resource)
Context -> Executor : CERT_LOAD(slot_node_id)
Executor -> Service : ResolveCertSlotHandle(client, slot_node_id)
Service -> DataManager : get client-scoped slot node
DataManager --> Service : CertSlotHandle
Service --> Executor : slot handle and configuration

Executor -> Service : LoadCertificate(client, slot, parent node)
Service -> SlotManager : LoadCertificate(slot, client)
SlotManager -> SlotManager : CheckSlotAccess(client)
alt live certificate-cache entry
  SlotManager --> Service : shared CertObject
else cache miss
  SlotManager -> Backend : LoadCertificate(slot config)
  Backend -> Backend : read bytes, parse DER or PEM
  Backend --> SlotManager : immutable CertObject
  SlotManager -> SlotManager : cache weakly\n(only if the slot generation is unchanged)
  SlotManager --> Service : CertObject
end
Service -> Registry : RegisterSlotCert(slot, new CertEntry(client))
Service -> DataManager : add CertDataNode under the context node
DataManager --> Service : certificate node id
Service --> Executor : node id
Executor --> Context : response
Context --> App : certificate resource guard

note over Service, SlotManager
  The CertObject bytes are shared between clients. Every load creates
  its own CertEntry, so per-client state such as a session CRL never
  reaches another client.
end note
@enduml
