@startuml uc_certificate_verification
title Use Case: Verify a Certificate Against a Trust Store
autonumber
hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ParticipantPadding 18
skinparam sequenceMessageAlign center

actor Application as App
participant "Verification context + IPC" as Context
participant "CERT:VERIFICATION\nhandler" as Handler
participant "CertManagementService" as Service
participant "TrustStoreManager" as TrustManager
participant "TrustStoreHandler" as StoreHandler
participant "CertSlotManager" as SlotManager
participant "Provider verifier" as Verifier

App -> Context : SetLeaf(certificate resource)
Context -> Handler : SetLeaf(node id)
Handler -> Service : resolve the client's CertEntry
Service --> Handler : CertEntry

App -> Context : SetVerificationTrustStore(store resource)
Context -> Handler : SetTrustStore(node id)
Handler -> Service : ResolveTrustStoreForOperation(client, node id)
Service --> Handler : TrustStoreHandle
Handler -> TrustManager : AddRef(handle, client)
TrustManager -> StoreHandler : warm the cache if cold
alt store cache is cold
  loop enabled members
    StoreHandler -> SlotManager : LoadCertificateForTrustStore(slot)
    SlotManager --> StoreHandler : shared CertObject
    StoreHandler -> SlotManager : LoadCrlDataForTrustStore(slot)
    SlotManager --> StoreHandler : shared CrlData::Sptrc (null if none)
  end
end
alt a member certificate or CRL exists but cannot be read
  TrustManager --> Handler : error, no reference is kept
  Handler --> Context : error
else cache warm
  TrustManager --> Handler : ok
end

App -> Context : Verify()
Context -> Handler : verify request
Handler -> TrustManager : GetStore(handle)
TrustManager --> Handler : trust-store handler
Handler -> StoreHandler : GetAnchors()
StoreHandler --> Handler : anchors (from the warm cache)
Handler -> StoreHandler : GetCrls()
StoreHandler --> Handler : CRL snapshots (from the warm cache)
Handler -> Verifier : DoVerify(leaf, chain, anchors, policy, CRLs)
Verifier -> Verifier : build path, check validity and revocation
Verifier --> Handler : result and verified chain
Handler --> Context : result
Context --> App : result; chain available on success

note over Handler, TrustManager
  Binding a store increments a per-client reference count and warms the store's
  cache; a bind that cannot read an existing member certificate or CRL fails and
  keeps no reference. Reset, close, or client cleanup releases the reference, and the
  last release clears the cache without affecting another client's active store.
end note

note over StoreHandler, Verifier
  Anchors and CRLs come from enabled members only; a conditional member
  whose content changed stays disabled until it is acknowledged. The CRL
  set is used when CRL-based revocation checking is selected.
end note
@enduml
