@startuml mediator_overview
title Mediator: Component Boundary and Collaborators
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle
skinparam ArrowColor #46535E

component "Control Plane" as CP
component "Registries\n(factories, resolvers, queries)" as REG
package "Mediator" {
  component "MediatorImpl\n(dispatch)" as MED
  component "Decoder" as DEC
  component "HandlerSelector" as SEL
  component "ProviderArbiter" as ARB
  component "ContextAssembler" as ASM
}
component "Provider Manager\nand providers" as PM
component "Key Management" as KM
component "Data Manager" as DM
component "Context handler" as H

CP --> MED : operation request
MED --> DEC : CTX_CREATE parameters
MED --> SEL : decoded request
SEL --> ARB : provider-served types
MED --> ASM : handler + provider id
SEL --> REG : registered factory
ARB --> PM : provider, handler factory
ARB --> KM : key affinity
ASM --> DM : context node
ASM --> KM : bind and authorize
ASM --> H : initialize
MED --> H : forward operation
@enduml
