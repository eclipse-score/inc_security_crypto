@startuml uc_context_creation
title Use Case: Create a Context (CTX_CREATE)
autonumber
hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ParticipantPadding 18
skinparam sequenceMessageAlign center

actor Client
participant "MediatorImpl" as Mediator
participant "Decoder" as Decoder
participant "Context factory\n(registered)" as Factory
participant "ProviderArbiter" as Arbiter
participant "ContextAssembler" as Assembler
participant "KeyManagementService" as KeyMgmt
participant "IDataManager" as DataMgr
participant "Handler" as Handler

Client -> Mediator : CTX_CREATE(type, algorithm, preference, key, ...)
Mediator -> Decoder : DecodeContextCreationRequest
alt validation fails
  Decoder --> Mediator : kInvalidArgument, or kUnsupportedAlgorithm\nfor an unknown algorithm
  Mediator --> Client : error
  note right: No provider is asked.\nNo node is created.
else valid
  Decoder --> Mediator : ContextCreationRequest
  alt a factory is registered for the context type
    alt the request references a key
      Mediator --> Client : kKeyOperationNotPermitted
      note right: The factory is not called.
    else
      Mediator -> Factory : Create(request)
      Factory --> Mediator : handler, or error (returned to the client)
    end
  else provider-served type
    Mediator -> Arbiter : Select(request)
    opt key referenced
      Arbiter -> KeyMgmt : ResolveTargetProvider
    end
    Arbiter --> Mediator : provider + handler, or error
  end
  Mediator -> Assembler : Assemble(request, handler)
  Assembler -> DataMgr : add context node under connection
  opt key referenced
    Assembler -> KeyMgmt : BindAndAuthorize
  end
  Assembler -> Handler : InitializeContext(identity, bound key,\nunchanged creation parameters)
  alt bind or initialization fails
    Assembler -> DataMgr : remove context node
    Assembler --> Mediator : error
    Mediator --> Client : error as public code
  else
    Assembler --> Mediator : context node id
    Mediator --> Client : context node id
  end
end
@enduml
