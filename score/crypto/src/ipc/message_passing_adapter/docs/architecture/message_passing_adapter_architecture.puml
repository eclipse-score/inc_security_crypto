@startuml message_passing_adapter_architecture
!theme plain

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam component {
    BackgroundColor #F1F7F5
    BorderColor #376A78
    FontColor #20313A
}
skinparam package {
    BorderColor #80909B
    FontColor #20313A
}

title Message-Passing Adapter Static Architecture

actor "User" as Caller

package "Client Side" as ClientSide {
    component "MessagePassingControlClient" as Client
    component "ClientSession" as ClientSession
    component "PendingCallRegistry" as PendingRegistry
    component "PendingCall" as PendingCall

    Client *-- ClientSession : owns
    ClientSession *-- PendingRegistry : owns
    PendingRegistry o-- PendingCall : tracks
}

package "Control Protocol" as Protocol {
    interface "IControlCodec" as IControlCodec
}

package "Transport" as Transport {
    package "SCORE Message Passing" as MessagePassing {
        interface "IClientConnection" as IClientConnection
        interface "IServerConnection" as IServerConnection
    }
}

package "Server Side" as ServerSide {
    component "MessagePassingControlServer" as Server
    component "SessionManager" as SessionManager
    component "WorkItemDispatcher" as Dispatcher

    component "SessionRegistry" as SessionRegistry
    component "FixedWorkerWorkItemExecutor" as Executor

    component "Session" as Session
    component "WorkItem" as WorkItem

    Server --> SessionManager : connect and disconnect
    SessionManager --> SessionRegistry : manages
    SessionRegistry o-- Session : maps connections

    Server --> Dispatcher : request bytes

    Session *-- WorkItem : tracks by request ID

    Dispatcher --> SessionManager : resolves session
    Dispatcher --> Executor : submits work
}

package "Daemon Control Plane" as ControlPlane {
    interface "IRequestHandler" as RequestHandler
}

Caller <..> ClientSide

ClientSession --> IControlCodec : uses
ClientSession --> IClientConnection : uses Send and response callbacks
Server --> IServerConnection : uses connection callbacks
Session --> IServerConnection : uses Notify for responses
Dispatcher --> IControlCodec : uses

Dispatcher <..> ControlPlane

@enduml
