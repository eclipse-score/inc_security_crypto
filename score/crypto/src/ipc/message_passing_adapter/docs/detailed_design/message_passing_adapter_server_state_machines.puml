@startuml message_passing_adapter_state_machines
!theme plain
skinparam shadowing false
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam state<<root>> {
  BackgroundColor LightYellow
  BorderColor DarkGoldenRod
}
skinparam ArrowFontSize 11
skinparam ranksep 40
skinparam nodesep 30

title Server-side State Machines and Their Interaction

state "ServerStateMachine\n(one per server)" as SSM {
  state "kStarting" as SSM_Starting
  state "kStarted" as SSM_Started
  state "kStopping" as SSM_Stopping
  state "kTerminating" as SSM_Terminating
  state "kStopped" as SSM_Stopped

  [*] --> SSM_Stopped
  SSM_Stopped -[#blue]-> SSM_Starting : Start()\n[TryBeginStart]
  SSM_Starting -[#blue]-> SSM_Started : Start() succeeded\n[MarkStarted]
  SSM_Starting -[#blue]-> SSM_Stopped : Start() failed\n[RollbackStartup; MarkStartupFailed]
  SSM_Started -[#orange]-> SSM_Stopping : Stop()\n[BeginStopping]
  SSM_Stopping -[#orange]-> SSM_Terminating : WaitForTermination()\n[BeginTermination]
  SSM_Terminating -[#orange]-> SSM_Stopped : termination complete\n[MarkStopped]

  SSM_Starting : do / **S1** Start(handler_factory) [Executor]
  SSM_Starting : do / **S2** StartAcceptConnections() [SessionRegistry]
  SSM_Stopping : entry / **S3** StopAcceptConnections(), DrainConnections() [SessionRegistry]
  SSM_Stopping : entry / **S4** Disconnect() for each detached [Session]
  SSM_Terminating : do / **S5** WaitForAllConnectionsClosed() [SessionRegistry]
  SSM_Terminating : exit / **S6** Shutdown() + Join() [Executor]
}

state "FixedWorkerWorkItemExecutor\nimplements IWorkItemSubmitter:\nTrySubmitWorkItem() / TrySubmitCleanup()\n(implicit state: m_started / m_stopping)" as EX {
  state "Not started" as EX_Idle
  state "Running" as EX_Running
  state "Stopping" as EX_Stopping

  [*] --> EX_Idle
  EX_Idle -[#blue]-> EX_Running : Start(handler_factory)\n[all workers initialized]
  EX_Running -[#orange]-> EX_Stopping : Shutdown()\n[m_stopping = true]
  EX_Stopping -[#orange]-> EX_Idle : Join()\n[all workers exited]
  EX_Idle -[#blue]-> EX_Idle : Start() failed\n[internal Shutdown + Join]

  EX_Running : do / **R4** PrepareForExecution(), processRequest() [WorkItem]
  EX_Running : do / **D6** RunCleanup() [Session]
}

state "SessionRegistry\nClientLifecycleState\n(one per client_id)" as RC {
  state "kConnectionActive" as RC_Active
  state "kCleanupPending" as RC_Pending
  state "kConnectionQuarantined" as RC_Quar
  state "entry removed\n(UID slot released)" as RC_Removed

  [*] -[#purple]-> RC_Active : TryRegisterAuthorizedConnection()\n[admissions enabled, capacity ok]
  RC_Active -[#red]-> RC_Pending : DetachConnection()
  RC_Pending -[#red]-> RC_Removed : OnCleanupFinished(client_id, true)
  RC_Pending -[#red]-> RC_Quar : OnCleanupFinished(client_id, false)\nor UID reservation missing

  RC_Active : entry / **C2** SessionFactory creates [Session]
  RC_Pending : entry / **D2** BeginDisconnect() [Session]
}

state "Session\n(one per connection)" as SE {
  state "kActive" as SE_Active
  state "kDrainingWork" as SE_Draining
  state "kReadyForCleanup" as SE_Ready
  state "kCleanupRunning" as SE_Running
  state "kCleanupFinished" as SE_Finished
  state "kCleanupFailed" as SE_Failed

  [*] -[#purple]-> SE_Active : SessionFactory (on connect)
  SE_Active -[#red]-> SE_Draining : BeginDisconnect()
  SE_Draining -[#red]-> SE_Ready : MarkReadyForCleanupIfDrained()\n[m_work_items empty]\nfrom Disconnect() or OnWorkItemCompleted()
  SE_Ready -[#red]-> SE_Running : RunCleanup()\n[BeginCleanup, on worker]
  SE_Ready -[#red]-> SE_Finished : StartCleanupJob()\n[no cleanup_callback]
  SE_Ready -[#red]-> SE_Failed : TrySubmitCleanup() failed\nor threw
  SE_Running -[#red]-> SE_Finished : cleanup_callback OK
  SE_Running -[#red]-> SE_Failed : cleanup_callback failed\nor threw

  SE_Active : do / **R5** connection.Notify(response bytes) [IServerConnection]
  SE_Draining : do / wait for admitted [WorkItem]s to complete
  SE_Ready : entry / **D6** TrySubmitCleanup(RunCleanup) [Executor]
  SE_Finished : entry / **D8** OnCleanupFinished(client_id, true) [SessionRegistry]
  SE_Failed : entry / **D8** OnCleanupFinished(client_id, false) [SessionRegistry]
}

state "WorkItem\n(one per request)" as WI {
  state "kQueued" as WI_Queued
  state "kRunning" as WI_Running
  state "kDeadlineExpired" as WI_Expired
  state "kCompleted" as WI_Completed

  [*] -[#green]-> WI_Queued : WorkItem::Create()\n[OnRequest]
  WI_Queued -[#green]-> WI_Running : PrepareForExecution()\n[deadline not reached]
  WI_Queued -[#green]-> WI_Expired : PrepareForExecution()\n[deadline reached]
  WI_Queued -[#green]-> WI_Completed : Complete()\n[admission / submit /\ndeserialize failed]
  WI_Running -[#green]-> WI_Completed : Complete()\n[handler done, response sent attempted]
  WI_Expired -[#green]-> WI_Completed : Complete()\n[kOperationTimedOut response]
  WI_Completed -[#red]-> [*] : erased from Session::m_work_items

  WI_Completed : entry / **R7** / **D4** OnWorkItemCompleted() [Session]
}

note right of RC
  m_accept_connections flag (not a client state):
  StartAcceptConnections() / StopAcceptConnections()
  gate TryRegisterAuthorizedConnection()
  (kConnectionFailed while no connections are accepted).
end note

note right of EX
  Rejections: kInvalidState unless Running.
  Work: kProviderBusy if no idle worker.
  Cleanup: queued if no idle worker,
  kResourceBusy if queue is full.
end note

' ---- Independent roots: callbacks registered on the SCORE message-passing server ----
state "SCORE Message Passing\nIServerConnection\n(callbacks of MessagePassingControlServer)" as TP {
  state "OnConnect(connection)\n[SessionManager]" as ROOT_C <<root>>
  state "OnRequest(connection, message)\n[WorkItemDispatcher]" as ROOT_R <<root>>
  state "OnDisconnect(connection)\n[SessionManager]" as ROOT_D <<root>>

  ROOT_C : do / **C1** TryRegisterAuthorizedConnection() [SessionRegistry]
  ROOT_R : do / **R1** WorkItem::Create() [WorkItem]
  ROOT_R : do / **R2** TryAdmitWorkItem() [Session]
  ROOT_R : do / **R3** TrySubmitWorkItem() [Executor]
  ROOT_R : do / **R5** Respond() [Session]
  ROOT_R : do / **R6** Complete() [WorkItem]
  ROOT_D : do / **D1** DetachConnection() [SessionRegistry]
}

' ---- Cross-machine interactions (dashed, numbered per flow) ----

' Flow C (purple): connection establishment
ROOT_C -[dashed,#purple]-> RC : **C1** TryRegisterAuthorizedConnection()\n[authorized, admissions enabled, capacity ok]
RC -[dashed,#purple]-> SE : **C2** SessionFactory creates Session

' Flow R (green): request handling
ROOT_R -[dashed,#green]-> WI : **R1** WorkItem::Create() [Session must be kActive]\n**R6** Complete() [after Respond(), also on error]
ROOT_R -[dashed,#green]-> SE : **R2** TryAdmitWorkItem() [only while kActive]\n**R5** Respond(response bytes) [only while kActive]\n[worker thread after R4, or directly on R2 / R3 error]
ROOT_R -[dashed,#green]-> EX : **R3** TrySubmitWorkItem(session, item, job)
EX -[dashed,#green]-> WI : **R4** worker runs job:\nPrepareForExecution(), processRequest()
SE -[dashed,#green]-> TP : **R5** connection.Notify(response bytes)

' Flow D (red): disconnect and cleanup
ROOT_D -[dashed,#red]-> RC : **D1** DetachConnection()
RC -[dashed,#red]-> SE : **D2** Session::BeginDisconnect()\n[before erasing the connection mapping]
ROOT_D -[dashed,#red]-> SE : **D3** Session::Disconnect()\n[after registry lock release; starts cleanup if ready]
SE -[dashed,#red]-> WI : **D4** admitted work items drain before cleanup
WI -[dashed,#red]-> SE : **R7** / **D5** Complete() calls OnWorkItemCompleted()\n[Session draining and last item: kReadyForCleanup]
SE -[dashed,#red]-> EX : **D6** TrySubmitCleanup(RunCleanup)
EX -[dashed,#red]-> SE : **D7** worker runs RunCleanup()
SE -[dashed,#red]-> RC : **D8** FinishCleanup() calls\nOnCleanupFinished()

' Flow S (blue): server start / stop
SSM -[dashed,#blue]-> EX : **S1** Start(): executor Start(handler_factory)
SSM -[dashed,#blue]-> RC : **S2** Start(): StartAcceptConnections()
SSM -[dashed,#orange]-> RC : **S3** Stop(): StopAcceptConnections(), then DrainConnections()\ncalls DetachAllConnections() [every client is marked kCleanupPending, begins session draining, then loses its mapping]\n**S5** WaitForTermination(): WaitForAllConnectionsClosed()\n[blocks until D8 completed for all clients]
SSM -[dashed,#orange]-> SE : **S4** DrainConnections() calls Session::Disconnect()\nfor every detached Session after registry unlock, continues as D4 to D8
SSM -[dashed,#orange]-> EX : **S6** WaitForTermination(): Shutdown() + Join()\n[only after S5, so cleanup jobs (D5) can still be submitted]

legend right
  Solid arrows: state transitions (label = trigger [action / guard]),
  drawn in the colour of the flow whose call triggers them.
  Black: no cross-machine trigger (initial state).
  Yellow boxes: independent roots (callbacks of the SCORE message-passing
  server), not state machines.
  Dashed arrows: cross-machine interactions, one arrow per source,
  target and colour; the numbers in its label give the order.
  State activities (entry / do / exit) name the call made into another
  state machine while in that state, with the same flow number; the
  target machine is given in square brackets.
    C1-C2 (purple): OnConnect, connection establishment.
    R1-R7 (green): OnRequest, admission, submission, execution, response.
    D1-D8 (red): OnDisconnect, draining and cleanup.
    S1-S2 (blue): ServerStateMachine Start() from kStopped through kStarting.
    S3-S6 (orange): ServerStateMachine Stop() / WaitForTermination() from kStopping.
  Session::Respond() is only allowed while the Session is kActive.
endlegend

@enduml
