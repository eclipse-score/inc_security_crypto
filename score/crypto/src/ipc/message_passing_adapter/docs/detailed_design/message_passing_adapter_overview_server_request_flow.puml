@startuml message_passing_adapter_server_request_flow
!theme plain
skinparam sequenceMessageAlign center
skinparam shadowing false

title Server-Side Request Handling

participant "SCORE message-passing IPC" as Transport
participant "MessagePassingControlServer" as Server
participant "WorkItemDispatcher" as Dispatcher
participant "SessionManager" as SessionManager
participant "SessionRegistry" as Registry
participant "Session" as Session
participant "Worker executor" as Executor
participant "IRequestHandler" as Handler
participant "FlatBufferCodec" as Codec
participant "IServerConnection" as ServerConnection

Transport -> Server: **OnRequest(connection, bytes) callback**
Server -> Dispatcher: WorkItemDispatcher::OnRequest(bytes)
Dispatcher -> SessionManager: Find session for connection
SessionManager -> Registry: FindSessionForRequest(connection)
Registry --> SessionManager: Session
SessionManager --> Dispatcher: Session
Dispatcher -> Session: TryAdmitWorkItem(item)
Dispatcher -> Executor: Submit(session, item, job)

... worker executes accepted operation ...

Executor -> Dispatcher: RunAcceptedWorkItem(item, handler)
Dispatcher -> Codec: DeserializeRequest(item bytes)
Codec --> Dispatcher: ControlRequest
Dispatcher -> Handler: processRequest(request)
Handler --> Dispatcher: ControlResponse
Dispatcher -> Codec: SerializeResponse(response)
Codec --> Dispatcher: Response bytes
Dispatcher -> Session: Respond(response bytes)
Session -> ServerConnection: **IServerConnection::Notify(bytes)**
ServerConnection -> Transport: Response notification

@enduml
