  <diagram id="key-lifecycle" name="Key Lifecycle &amp; Session Binding">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="kl_title" value="&lt;b&gt;Key Lifecycle &amp; Session Binding&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="550" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- Node Tree -->
        <mxCell id="tree_title" value="&lt;b&gt;DataManager Node Hierarchy (per client session)&lt;/b&gt;" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="400" height="30" as="geometry" />
        </mxCell>

        <mxCell id="n_root" value="&lt;b&gt;CLIENT_ENTRY&lt;/b&gt;&#xa;(pid=1234, uid=10038)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n_conn" value="&lt;b&gt;ConnectionDataNode&lt;/b&gt;&#xa;connection_node_id=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="140" y="220" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n_slot" value="&lt;b&gt;KeySlotDataNode&lt;/b&gt;&#xa;key_node_id=2&#xa;slot=HMAC_SHA256_IntegrationTestKey_OpenSSL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="220" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n_ctx" value="&lt;b&gt;ContextDataNode&lt;/b&gt;&#xa;context_node_id=3&#xa;handler=OpenSslHmacHandler, algo=HMAC-SHA256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="340" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n_key" value="&lt;b&gt;KeyDataNode&lt;/b&gt;&#xa;bound to context&#xa;refs → KeyEntry (OpenSslKeyHandler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="140" y="440" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- Tree edges -->
        <mxCell id="te1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n_root" target="n_conn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n_root" target="n_slot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n_conn" target="n_ctx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n_ctx" target="n_key">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Key Lifecycle States -->
        <mxCell id="kl_states_title" value="&lt;b&gt;Key Material Lifecycle&lt;/b&gt;" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="80" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ks1" value="1. &lt;b&gt;Configured&lt;/b&gt;&#xa;(crypto_config.json loaded at startup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="880" y="120" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ks2" value="2. &lt;b&gt;Resolved&lt;/b&gt;&#xa;(ResolveResource → KeySlotDataNode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="200" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ks3" value="3. &lt;b&gt;Loaded&lt;/b&gt;&#xa;(LoadOrShare → read from deployment_path)&#xa;Deduplication: shared if already loaded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="880" y="280" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ks4" value="4. &lt;b&gt;Bound&lt;/b&gt;&#xa;(BindKeyToContext → KeyDataNode under context)&#xa;Provider affinity enforced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="880" y="370" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ks5" value="5. &lt;b&gt;Active&lt;/b&gt;&#xa;(InitializeContext → EVP_MAC_CTX ready)&#xa;Key bytes accessible via IKeyHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="880" y="460" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ks6" value="6. &lt;b&gt;Released&lt;/b&gt;&#xa;(Context close → cascade delete)&#xa;Key zeroized when last ref drops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="880" y="550" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- State arrows -->
        <mxCell id="sa1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ks1" target="ks2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sa2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ks2" target="ks3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sa3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ks3" target="ks4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sa4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ks4" target="ks5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sa5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ks5" target="ks6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Security Properties -->
        <mxCell id="sec_title" value="&lt;b&gt;Security Properties&lt;/b&gt;" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="sec_box" value="• &lt;b&gt;Isolation&lt;/b&gt;: Key material never crosses IPC boundary&#xa;• &lt;b&gt;Affinity&lt;/b&gt;: Provider determined by slot config, not client&#xa;• &lt;b&gt;Deduplication&lt;/b&gt;: Same slot loaded once, shared via ref-count&#xa;• &lt;b&gt;RAII&lt;/b&gt;: Auto-zeroize on last reference drop&#xa;• &lt;b&gt;Access Control&lt;/b&gt;: UID checked during ResolveResource&#xa;• &lt;b&gt;Path Safety&lt;/b&gt;: IsDeploymentPathSafe() rejects relative paths&#xa;• &lt;b&gt;Cross-provider Guard&lt;/b&gt;: Cannot bind key to mismatched provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="500" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
