          <mxGeometry x="80" y="85" width="320" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;ICryptoStack&lt;/b&gt;&#xa;CryptoStackFactory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;ICryptoContext&lt;/b&gt;&#xa;CryptoContextImpl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;IMacContext&lt;/b&gt;&#xa;MacContextImpl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="200" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- IPC Layer -->
        <mxCell id="ipc_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ipc_label" value="&lt;b&gt;IPC Transport (gRPC + FlatBuffers)&lt;/b&gt;&#xa;unix:///tmp/crypto_daemon.sock" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- Daemon Layer -->
        <mxCell id="daemon_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1700" height="700" as="geometry" />
        </mxCell>
        <mxCell id="daemon_label" value="&lt;b&gt;Crypto Daemon Process&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="700" y="445" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- Mediator -->
        <mxCell id="d1" value="&lt;b&gt;MediatorImpl&lt;/b&gt;&#xa;(Request Dispatcher)&#xa;&#xa;• HandleContextCreation&#xa;• HandleResolveResource&#xa;• HandleMacOperation&#xa;• HandleKeyManagement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Data Manager -->
        <mxCell id="d2" value="&lt;b&gt;DataManager&lt;/b&gt;&#xa;(Session Store)&#xa;&#xa;• Node hierarchy per client&#xa;• Connection/Context/Key nodes&#xa;• RAII lifecycle management&#xa;• Cascade delete on close" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="490" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Key Management -->
        <mxCell id="d3" value="&lt;b&gt;KeyManagementService&lt;/b&gt;&#xa;&#xa;• ResolveTargetProvider()&#xa;• BindKeyToContext()&#xa;• LoadOrShare() (dedup)&#xa;• Cross-provider guard&#xa;• KeyRegistry (ref-counted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="490" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Slot Registry -->
        <mxCell id="d4" value="&lt;b&gt;SlotRegistry&lt;/b&gt;&#xa;&#xa;• name → SlotHandle map&#xa;• Access policy (UID check)&#xa;• Provider ID resolution&#xa;• Config from crypto_config.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="490" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Provider Manager -->
        <mxCell id="d5" value="&lt;b&gt;ProviderManager&lt;/b&gt;&#xa;&#xa;• CreateProviders()&#xa;• InitializeAll()&#xa;• GetProvider(id/name/type)&#xa;• Type→Provider mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1280" y="490" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Provider Implementations -->
        <mxCell id="prov_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;dashPattern=3 3;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="860" height="200" as="geometry" />
        </mxCell>
        <mxCell id="prov_label" value="&lt;b&gt;Crypto Providers&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="705" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="prov1" value="&lt;b&gt;OpenSSL Provider&lt;/b&gt;&#xa;(ProviderType::kSoftware)&#xa;&#xa;├─ HandlerFactory&#xa;├─ OpenSslHmacHandler&#xa;├─ FileBackedSlotHandler&#xa;└─ OpenSslKeyHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="730" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="prov2" value="&lt;b&gt;PKCS#11 Provider&lt;/b&gt;&#xa;(ProviderType::kHardware)&#xa;&#xa;├─ HandlerFactory&#xa;├─ Pkcs11HmacHandler&#xa;├─ Pkcs11SlotHandler&#xa;└─ HsmKeyHandler&#xa;&#xa;&lt;i&gt;(Optional - continues on failure)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="730" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="prov3" value="&lt;b&gt;Future Providers&lt;/b&gt;&#xa;(Extensible)&#xa;&#xa;• QNX Crypto Engine&#xa;• ARM TrustZone&#xa;• Custom HSM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="660" y="730" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Config Files -->
        <mxCell id="config_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=3 3;" vertex="1" parent="1">
          <mxGeometry x="1000" y="700" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="config_label" value="&lt;b&gt;Configuration&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1280" y="705" width="140" height="20" as="geometry" />
        </mxCell>

        <mxCell id="cfg1" value="&lt;b&gt;crypto_config.json&lt;/b&gt;&#xa;&#xa;• Slot definitions&#xa;• algorithm, allowed_ops&#xa;• deployment_path&#xa;• allowed_uids&#xa;• provider_names" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="730" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cfg2" value="&lt;b&gt;*.kv / *.key&lt;/b&gt;&#xa;&#xa;• Key material files&#xa;• deployment_format:&#xa;  RAW / PEM / DER&#xa;• Absolute paths required&#xa;  (IsDeploymentPathSafe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1250" y="730" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cfg3" value="&lt;b&gt;exec_config.json&lt;/b&gt;&#xa;&#xa;• App manifest&#xa;• UID/GID mappings&#xa;• Resource permissions&#xa;• IPC socket path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1480" y="730" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- Arrows between components -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jetSize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2">
