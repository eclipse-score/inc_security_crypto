        <!-- Notes -->
        <mxCell id="note1" value="&lt;b&gt;Session Node Hierarchy:&lt;/b&gt;&#xa;&#xa;CLIENT_ENTRY (per pid+uid)&#xa;├─ ConnectionDataNode (connection_id)&#xa;│   ├─ ContextDataNode (MAC context)&#xa;│   │   └─ KeyDataNode (bound key ref)&#xa;│   └─ ContextDataNode (HASH context)&#xa;└─ KeySlotDataNode (resolved slot)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="2200" y="160" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;Key Loading (LoadOrShare):&lt;/b&gt;&#xa;&#xa;1. Check if slot already loaded (dedup)&#xa;2. If not: FileBackedSlotHandler reads&#xa;   key file from deployment_path&#xa;3. Registers in provider's KeyRegistry&#xa;4. Creates KeyDataNode under context&#xa;5. Key material lives in IKeyHandler&#xa;6. RAII: auto-zeroize on last ref drop" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="2200" y="380" width="320" height="180" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;Provider Resolution:&lt;/b&gt;&#xa;&#xa;• Key-affinity: slot → provider_ids[0]&#xa;• Type-based: ProviderType → ProviderId map&#xa;• Cross-provider guard prevents mismatched&#xa;  key/handler combinations&#xa;• Provider determined at context creation,&#xa;  NOT at operation time" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="2200" y="600" width="320" height="170" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="daemon-architecture" name="Daemon Architecture">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="arch_title" value="&lt;b&gt;Score Crypto Daemon — Component Architecture&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Client Layer -->
        <mxCell id="client_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
