          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="IPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jetSize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="ipc_box" target="d1">
          <mxGeometry relative="1" as="geometry" />
